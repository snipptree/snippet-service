# Binaries for programs and plugins (Windows, Linux, macOS)
*.exe
*.exe~
*.dll
*.so
*.dylib

# Ignore Go binaries without extensions (for Linux and macOS)
*.out
*.a
*.o
/bin/
/dist/
/build/

# Ignore specific Go binaries generated by build command
snippetApp


# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Ignore .env file (configuration or secrets)
.env

# macOS system files
.DS_Store
